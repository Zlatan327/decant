# Server-side only. Generate a long random operator key before starting.
DECANT_ADMIN_KEY=
DATABASE_PATH=data/decant.db
HOST=127.0.0.1
PORT=8080
CORS_ORIGINS=http://localhost:3000

# OpenAI-compatible endpoint. Configure a real provider model you can access.
UPSTREAM_BASE_URL=
UPSTREAM_API_KEY=
UPSTREAM_MODEL=

# Alternatively, use Gemini with an actual available model ID.
GEMINI_API_KEY=
GEMINI_MODEL=

# NEAR Testnet reconciliation (restricted function-call key, server-side only).
NEAR_CONTRACT_ID=
NEAR_ACCOUNT_ID=
NEAR_SETTLEMENT_PRIVATE_KEY=
NEAR_RPC_URL=

# Optional public contract ID for the dashboard’s read-only Testnet lookup.
VITE_DECANT_NEAR_CONTRACT_ID=
